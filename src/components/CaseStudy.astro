---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CaseStudyBlock } from '../data/projects';
import { url } from '../data/site';
import { bold } from '../lib/markup';

// Shared layout for /work/<slug> and the LumiMeds page.
export interface Props {
  eyebrow: string;
  title: string;
  tagline: string;
  meta: { role: string; stack: string; type: string };
  links?: { live?: string; repo?: string };
  hero?: {
    image?: ImageMetadata;
    bg: string;
    fit: 'cover' | 'contain';
    alt?: string;
    /** crop ratio, e.g. '16 / 7' */
    ratio?: string;
    /** crop focus, e.g. '60% 70%' */
    position?: string;
    /** image becomes the poster */
    video?: { mp4: string; webm?: string };
  };
  blocks: CaseStudyBlock[];
  next?: { slug: string; name: string };
}

const { eyebrow, title, tagline, meta, links = {}, hero, blocks, next } = Astro.props;
---

<section id="project-hero">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="tagline">{tagline}</p>

    <div class="meta">
      <div><span>role</span><strong>{meta.role}</strong></div>
      <div><span>stack</span><strong>{meta.stack}</strong></div>
      <div><span>type</span><strong>{meta.type}</strong></div>
    </div>
  </section>

  <div class="hero-media">
    <div class="shot rise" style={`background:${hero?.bg ?? "var(--thumb-bg)"}`}>
    {
      hero?.video ? (
        <video
          class={`fit-${hero.fit}`}
          poster={hero.image?.src}
          muted
          loop
          playsinline
          preload="none"
          data-lazy-video
          aria-label={hero.alt ?? `${title} interface`}
        >
          {hero.video.webm && <source data-src={url(hero.video.webm)} type="video/webm" />}
          <source data-src={url(hero.video.mp4)} type="video/mp4" />
        </video>
      ) : hero?.image ? (
        <Image
          src={hero.image}
          alt={hero.alt ?? `${title} interface`}
          class={`fit-${hero.fit}`}
          style={hero.ratio ? `aspect-ratio:${hero.ratio}; object-fit:cover; object-position:${hero.position ?? 'center'};` : undefined}
          widths={[600, 1000, 1600]}
          sizes="(max-width: 900px) 92vw, 86vw"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <p class="shot-fallback">{title}</p>
      )
    }
    </div>

    {
      (links.live || links.repo) && (
        <div class="links">
          {links.live && (
            <a class="btn primary" href={links.live} target="_blank" rel="noopener noreferrer">
              View live site <span aria-hidden="true">→</span>
            </a>
          )}
          {links.repo && (
            <a class="btn ghost" href={links.repo} target="_blank" rel="noopener noreferrer">
              View code <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      )
    }
  </div>

  <slot />

  <div class="content">
    {
      blocks.map((block) => (
        <section class="block rise-stack">
          {block.quote ? (
            <blockquote class="quote">
              <p>{block.quote}</p>
            </blockquote>
          ) : (
            <>
              {block.label && <p class="label-sm">{block.label}</p>}
              {block.heading && <h2>{block.heading}</h2>}
              {block.body?.map((paragraph) => <p set:html={bold(paragraph)} />)}

              {block.list && (
                <ul class="list">
                  {block.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}

              {block.features && (
                <div class="features">
                  {block.features.map((feature) => (
                    <div class="feature">
                      <p class="name">{feature.name}</p>
                      <p>{feature.text}</p>
                    </div>
                  ))}
                </div>
              )}

              {block.stack && (
                <div class="pill-list">
                  {block.stack.map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
              )}
            </>
          )}
        </section>
      ))
    }

    {
      !next && (
        <nav class="next simple" aria-label="More work">
          <a class="underline-link" href={url('/#work')}>
            back to all work
          </a>
        </nav>
      )
    }
    {
      next && (
        <nav class="next" aria-label="More work">
          <span>next project</span>
          <p class="next-name">
            <a href={url(`/work/${next.slug}`)}>
              {next.name} <span aria-hidden="true">→</span>
            </a>
          </p>
          <a class="underline-link" href={url('/#work')}>
            back to all work
          </a>
        </nav>
      )
    }
  </div>

<style>
  /* hero */
  #project-hero {
    padding-bottom: clamp(36px, 6vh, 70px);
  }
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--plum);
    margin-bottom: 18px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 1.02;
    margin-bottom: 22px;
  }
  .tagline {
    font-size: clamp(16px, 2vw, 17px);
    color: var(--ink-3);
    max-width: 560px;
    line-height: 1.6;
    margin-bottom: clamp(28px, 4vh, 36px);
  }

  .meta {
    display: flex;
    gap: clamp(24px, 5vw, 48px);
    flex-wrap: wrap;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 26px;
  }
  .meta > div span {
    display: block;
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .meta > div strong {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
  }

  /* buttons sit under the hero media, aligned with its edge */
  .links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 18px var(--pad-x) 0;
  }
  .btn {
    font-size: 13px;
    font-weight: 500;
    padding: 11px 20px;
    border-radius: 20px;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn.primary {
    color: #fff;
    background: var(--plum);
  }
  .btn.ghost {
    color: var(--plum);
    border: 1px solid var(--plum);
  }

  /* hero media */
  .shot {
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(32px, 6vh, 80px) clamp(20px, 5vw, 60px);
    margin: 0 var(--pad-x);
  }
  .hero-media {
    margin-bottom: clamp(56px, 10vh, 120px);
  }
  .shot :global(video) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
  }
  .shot :global(img.fit-contain) {
    max-width: 280px;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .shot :global(img.fit-cover) {
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .shot-fallback {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(28px, 5vw, 48px);
    color: #fff;
    opacity: 0.85;
    text-align: center;
  }

  /* body */
  .content {
    max-width: var(--maxw-read);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .block {
    padding: 0;
    margin-bottom: clamp(52px, 9vh, 100px);
  }
  .label-sm {
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--plum);
    margin-bottom: 16px;
  }
  .block h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(23px, 3.4vw, 28px);
    margin-bottom: 20px;
    line-height: 1.3;
    text-wrap: balance;
  }
  .block p {
    font-size: 16px;
    color: var(--ink-2);
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .block :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }

  .list {
    padding-left: 20px;
    margin-bottom: 16px;
  }
  .list li {
    font-size: 16px;
    color: var(--ink-2);
    line-height: 1.75;
  }
  .list li::marker {
    color: var(--plum);
  }
  .block .pill-list {
    margin-top: 8px;
  }

  .features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 28px;
  }
  @media (min-width: 620px) {
    .features {
      grid-template-columns: 1fr 1fr;
    }
  }
  .feature {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px;
  }
  .feature .name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    margin-bottom: 8px;
    color: var(--ink);
  }
  .feature p {
    font-size: 14px;
    color: var(--ink-3);
    line-height: 1.6;
    margin: 0;
  }

  .quote {
    background: var(--plum-soft);
    border-left: 3px solid var(--plum);
    padding: clamp(22px, 4vw, 28px) clamp(22px, 4vw, 32px);
    border-radius: 0 10px 10px 0;
  }
  .quote p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(17px, 2.6vw, 20px);
    color: var(--ink);
    margin: 0;
    line-height: 1.5;
  }

  .next {
    border-top: 1px solid var(--line);
    padding-top: clamp(36px, 6vh, 70px);
    padding-bottom: clamp(36px, 6vh, 70px);
    text-align: center;
  }
  .next.simple {
    padding-top: clamp(28px, 5vh, 56px);
  }
  .next > span {
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .next-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 3.4vw, 26px);
    margin: 14px 0 22px;
  }
  .next-name a {
    text-decoration: none;
  }
  .next-name a:hover {
    color: var(--plum);
  }
</style>

<script>
  // Lazy-load the video near the viewport; pause when it leaves.
  const video = document.querySelector<HTMLVideoElement>('[data-lazy-video]');

  if (video) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const load = () => {
      if (video.dataset.loaded) return;
      video.dataset.loaded = 'true';
      for (const source of video.querySelectorAll('source')) {
        source.src = source.dataset.src!;
      }
      video.load();
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            load();
            if (reduced.matches) video.controls = true;
            else video.play().catch(() => (video.controls = true));
          } else if (!video.paused) {
            video.pause();
          }
        }
      },
      { rootMargin: '300px' }
    );

    observer.observe(video);
  }
</script>
