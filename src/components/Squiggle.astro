---
interface Props {
  /** 'b' flips the wave direction */
  variant?: 'a' | 'b';
}
const { variant = 'a' } = Astro.props;

const W = 760;
const H = 26;
const MID = H / 2;
const AMP = 3.4; // wave amplitude
const HALVES = 9; // half-waves across the width
const STEP = (W - 4) / HALVES;

// deterministic amplitude variation (0.78-1.0)
const jitter = (i: number) => 0.78 + 0.22 * (((i * 5) % 7) / 6);

function wave(startUp: boolean): string {
  let d = `M2 ${MID}`;
  for (let i = 0; i < HALVES; i++) {
    const dir = (startUp ? -1 : 1) * (i % 2 === 0 ? 1 : -1);
    const x0 = 2 + STEP * i;
    const x1 = x0 + STEP;
    // quadratic curve peaks at half the control point
    const cy = MID + dir * AMP * jitter(i) * 2;
    d += ` Q${(x0 + STEP / 2).toFixed(1)} ${cy.toFixed(1)} ${x1.toFixed(1)} ${MID}`;
  }
  return d;
}

const PATHS = { a: wave(true), b: wave(false) };
---

<svg
  class="squiggle"
  data-fx
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path d={PATHS[variant]}></path>
</svg>

<style>
  .squiggle {
    display: block;
    width: 100%;
    height: clamp(14px, 1.6vw, 22px);
    color: var(--line);
  }
  .squiggle path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* Fallback driven by --p from BaseLayout script */
  @media (prefers-reduced-motion: no-preference) {
    .squiggle path {
      stroke-dasharray: 1400;
      stroke-dashoffset: calc(1400 * (1 - clamp(0, (var(--p, 1) - 0.3) / 0.25, 1)));
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .squiggle path {
        stroke-dasharray: 1400;
        animation-name: squiggle-draw;
        animation-duration: auto;
        animation-timing-function: cubic-bezier(0.5, 0, 0.3, 1);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 30% cover 38%;
      }
    }
  }
  @keyframes squiggle-draw {
    from {
      stroke-dashoffset: 1400;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

</style>
