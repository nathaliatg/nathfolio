---
import { Image } from 'astro:assets';
import cat from '../assets/cat.png';
---

<button class="cat-trigger" data-cat-open aria-haspopup="dialog">wanna see a cat? 🐾</button>

<dialog class="cat-dialog" data-cat-dialog aria-label="a cat">
  <div class="cat-wrap">
    <Image
      class="cat"
      src={cat}
      alt="A black cat hanging upside down from the top of the screen, looking at you"
      widths={[600, 1000, 1600, 2000]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <button class="close" data-cat-close>close <span aria-hidden="true">✕</span></button>
</dialog>

<style>
  .cat-trigger {
    background: none;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 11px 20px;
    font-size: 13px;
    font-family: var(--font-body);
    color: var(--muted);
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .cat-trigger:hover {
    border-color: var(--plum);
    color: var(--plum);
  }

  .cat-dialog {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    overflow: hidden;
  }
  .cat-dialog::backdrop {
    background: rgba(0, 0, 0, 0.15);
  }
  .cat-dialog:not([open]) {
    display: none;
  }

  .cat-wrap {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    /* Right-aligned: the art bleeds off the right edge */
    display: flex;
    justify-content: flex-end;
    transform: translateY(-100%);
    transition: transform 0.55s cubic-bezier(0.2, 0.9, 0.25, 1.05);
  }
  .cat-dialog[data-shown] .cat-wrap {
    transform: translateY(0);
  }
  .cat-wrap :global(img) {
    display: block;
    width: 68%;
    height: auto;
    /* Don't shrink when wider than the screen */
    flex-shrink: 0;
  }
  /* Mobile: oversize and center the cat's face */
  @media (max-width: 700px) {
    .cat-wrap :global(img) {
      /* Override the global max-width reset */
      max-width: none;
      width: 200%;
      margin-right: -42%;
    }
  }

  .close {
    position: absolute;
    bottom: 28px;
    right: var(--gutter);
    font-size: 13px;
    font-family: var(--font-body);
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    border: 0;
    border-radius: 20px;
    padding: 10px 16px;
    cursor: pointer;
  }
  .close:hover {
    background: rgba(0, 0, 0, 0.65);
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-wrap {
      transform: translateY(0);
      transition: none;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-cat-dialog]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-cat-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-cat-close]');

  if (dialog && openBtn && closeBtn) {
    openBtn.addEventListener('click', () => {
      dialog.showModal();
      // Next frame so the transition runs
      requestAnimationFrame(() => dialog.setAttribute('data-shown', ''));
    });

    const close = () => {
      dialog.removeAttribute('data-shown');
      dialog.close();
    };
    closeBtn.addEventListener('click', close);
    dialog.addEventListener('close', () => dialog.removeAttribute('data-shown'));
    // Close on backdrop click
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
  }
</script>
